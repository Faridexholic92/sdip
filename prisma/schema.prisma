generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }
model DataSource { id String @id @default(uuid()) @db.Uuid; name String; organisation String; sourceType String; baseUrl String?; authorityLevel Int @default(0); active Boolean @default(true); createdAt DateTime @default(now()); events EventSource[] }
model DisasterEvent { id String @id @default(uuid()) @db.Uuid; externalId String?; eventName String; disasterType String; eventStart DateTime; eventEnd DateTime?; locationName String; district String; latitude Float?; longitude Float?; severity String?; description String?; verificationStatus String @default("DRAFT"); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; sources EventSource[]; @@index([district,eventStart]) }
model EventSource { id String @id @default(uuid()) @db.Uuid; eventId String @db.Uuid; sourceId String @db.Uuid; sourceUrl String?; publisher String?; publishedAt DateTime?; accessedAt DateTime @default(now()); event DisasterEvent @relation(fields:[eventId],references:[id]); source DataSource @relation(fields:[sourceId],references:[id]); @@index([eventId]) }
model RiskAssessment { id String @id @default(uuid()) @db.Uuid; district String; hazardType String; assessmentTime DateTime @default(now()); validUntil DateTime; modelVersion String; hazardScore Float; exposureScore Float; vulnerabilityScore Float; capacityScore Float; overallScore Float; riskLevel String; confidenceScore Float; dataCoverage Float; calculationTrace Json; @@index([district,hazardType,assessmentTime]) }
model IngestionRun { id String @id @default(uuid()) @db.Uuid; sourceName String; startedAt DateTime @default(now()); completedAt DateTime?; status String; received Int @default(0); valid Int @default(0); rejected Int @default(0); errorSummary String? }
